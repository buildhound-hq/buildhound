     name: core / Build PyEmscripten (\${{ matrix.python-version }})
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     strategy:
       fail-fast: false
       matrix:
@@ -306,7 +306,7 @@
 
   core-bench:
     name: core / Run Rust benchmarks
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
@@ -330,7 +330,7 @@
   core-test-builds-arch:
     name: core / Test build on \${{ matrix.target }}-\${{ matrix.distro }}
     needs: [core-build]
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     strategy:
       fail-fast: false
@@ -476,7 +476,7 @@
   core-test-msrv:
     name: core / Test MSRV
 
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
@@ -514,7 +514,7 @@
   # test with a debug build as it picks up errors which optimised release builds do not
   core-test-debug:
     name: core / Test with debug build (\${{ matrix.python-version }})
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     strategy:
       fail-fast: false
@@ -556,7 +556,7 @@
   core-test-python-debug:
     name: core / Test with debug Python (\${{ matrix.python-version }})
     if: startsWith(github.ref, 'refs/tags/') || contains(github.event.pull_request.labels.*.name, 'full build')
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     strategy:
       fail-fast: false
@@ -597,7 +597,7 @@
   test-pyemscripten:
     name: Test build on PyEmscripten (Pyodide) (\${{ matrix.python-version }})
     needs: [core-build-pyemscripten]
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     strategy:
       fail-fast: false
       matrix:
@@ -634,7 +634,7 @@
           python -c 'from pydantic_core._pydantic_core import build_info; print(f"{build_info=}")'
 
   build-pydantic:
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     if: startsWith(github.ref, 'refs/tags/')
     outputs:
       pydantic-version: \${{ steps.check-tag.outputs.VERSION }}
@@ -667,7 +667,7 @@
           path: dist
 
   docs-build:
