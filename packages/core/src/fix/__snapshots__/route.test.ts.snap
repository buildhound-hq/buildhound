exports[`applyRouting on real workflows (CLAUDE.md rule 1) > fastlane__fastlane__ci.yml, private: only runs-on changes, every comment survives 1`] = `
"===================================================================
--- a/.github/workflows/fastlane__fastlane__ci.yml
+++ b/.github/workflows/fastlane__fastlane__ci.yml
@@ -104,7 +104,7 @@
 
   validate_fastlane_swift_generation:
     name: Validate Fastlane.swift generation
-    runs-on: macos-26
+    runs-on: \${{ vars.BUILDHOUND_MACOS || 'macos-26' }}
     steps:
       - uses: actions/checkout@v7
 
@@ -122,7 +122,7 @@
 
   validate_documentation:
     name: Validate Documentation
-    runs-on: ubuntu-24.04
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-24.04' }}
     steps:
       - uses: actions/checkout@v7
 
@@ -136,7 +136,7 @@
 
   lint_source_code:
     name: Lint source code
-    runs-on: ubuntu-24.04
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-24.04' }}
     steps:
       - uses: actions/checkout@v7
 
"
`;

exports[`applyRouting on real workflows (CLAUDE.md rule 1) > fastlane__fastlane__ci.yml, public: only runs-on changes, every comment survives 1`] = `
"===================================================================
--- a/.github/workflows/fastlane__fastlane__ci.yml
+++ b/.github/workflows/fastlane__fastlane__ci.yml
@@ -104,7 +104,7 @@
 
   validate_fastlane_swift_generation:
     name: Validate Fastlane.swift generation
-    runs-on: macos-26
+    runs-on: \${{ ((github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || github.event_name == 'merge_group' || github.event_name == 'release') && vars.BUILDHOUND_MACOS || 'macos-26' }}
     steps:
       - uses: actions/checkout@v7
 
@@ -122,7 +122,7 @@
 
   validate_documentation:
     name: Validate Documentation
-    runs-on: ubuntu-24.04
+    runs-on: \${{ ((github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || github.event_name == 'merge_group' || github.event_name == 'release') && vars.BUILDHOUND_LINUX || 'ubuntu-24.04' }}
     steps:
       - uses: actions/checkout@v7
 
@@ -136,7 +136,7 @@
 
   lint_source_code:
     name: Lint source code
-    runs-on: ubuntu-24.04
+    runs-on: \${{ ((github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || github.event_name == 'merge_group' || github.event_name == 'release') && vars.BUILDHOUND_LINUX || 'ubuntu-24.04' }}
     steps:
       - uses: actions/checkout@v7
 
"
`;

