     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
@@ -856,7 +856,7 @@
 
   coverage-combine:
     needs: [test, test-mypy]
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     env:
       UV_NO_SYNC: '1'
 
@@ -899,7 +899,7 @@
 
   coverage-pr-comment:
     needs: coverage-combine
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     if: github.event_name == 'pull_request'
     permissions:
       pull-requests: write
@@ -930,7 +930,7 @@
 
   test-typing-extensions:
     name: Test typing-extensions (\`main\` branch) on Python \${{ matrix.python-version }}
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     strategy:
       fail-fast: false
       matrix:
@@ -960,7 +960,7 @@
     outputs:
       result: \${{ steps.all-green.outputs.result }}
     needs: [lint, docs-build, test, test-memray, test-mypy, test-plugin, core-test-os, core-test-debug, core-build-pyemscripten]
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     steps:
       - name: Decide whether the needed jobs succeeded or failed
@@ -972,7 +972,7 @@
   deploy-docs:
     needs: [check]
     if: needs.check.outputs.result == 'success' && (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/'))
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     steps:
       - name: Generate app token
         uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
@@ -994,7 +994,7 @@
   release-pydantic-core:
     needs: [core-test-builds-arch, core-test-builds-os, core-build-sdist, core-test-python-debug, check]
     if: needs.check.outputs.result == 'success' && startsWith(github.ref, 'refs/tags/')
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     environment: release
 
     permissions:
@@ -1053,7 +1053,7 @@
   release-pydantic:
     needs: [build-pydantic, release-pydantic-core]
     if: startsWith(github.ref, 'refs/tags/')
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
     environment: release
 
     permissions:
@@ -1091,7 +1091,7 @@
     name: Send tweet
     needs: [build-pydantic, release-pydantic]
     if: needs.release-pydantic.result == 'success'
-    runs-on: ubuntu-latest
+    runs-on: \${{ vars.BUILDHOUND_LINUX || 'ubuntu-latest' }}
 
     steps:
       - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
"
`;

