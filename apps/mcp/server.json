{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "sh.buildhound/mcp",
  "title": "Buildhound",
  "description": "Price your GitHub Actions CI, fix waste by pull request, and run jobs on machines you already have.",
  "repository": {
    "url": "https://github.com/buildhound-hq/buildhound",
    "source": "github",
    "subfolder": "apps/mcp"
  },
  "websiteUrl": "https://buildhound.sh/docs/mcp",
  "icons": [
    {
      "src": "https://buildhound.sh/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "0.1.7",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@buildhound/mcp",
      "version": "0.1.7",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GITHUB_TOKEN",
          "description": "A GitHub token for the repositories to scan and route; without it the server uses gh auth token.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
