{
  "name": "buildhound",
  "version": "0.1.4",
  "description": "Run GitHub Actions on the Macs and Linux machines you already have, in a clean VM per job, set up by your coding agent. Agent-first CLI.",
  "license": "MIT",
  "homepage": "https://buildhound.sh",
  "keywords": [
    "github-actions",
    "ci",
    "self-hosted-runner",
    "macos",
    "mac-mini",
    "linux",
    "runners",
    "mcp",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "buildhound": "./dist/index.js"
  },
  "exports": {
    "./ops": "./src/ops.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@buildhound/core": "workspace:*",
    "@buildhound/github": "workspace:*",
    "@buildhound/shared": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
